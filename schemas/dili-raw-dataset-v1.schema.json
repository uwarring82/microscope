{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/uwarring82/microscope/v0.2.0/schemas/dili-raw-dataset-v1.schema.json",
  "title": "Di-Li raw dataset and inspection session v1",
  "type": "object",
  "required": ["format", "frames"],
  "properties": {
    "format": {"const": "dili-raw-dataset-v1"},
    "identifier": {"type": "string", "description": "Dataset UUID URN; archival DOI may be added separately."},
    "data_license": {"type": "string"},
    "description": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "white_balance_gains": {"$ref": "#/$defs/gains"},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}}
  },
  "$defs": {
    "gains": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.125, "maximum": 8}},
    "software": {
      "type": "object",
      "description": "Repository-state snapshot cached at first use in a process; not a loaded-code attestation. New fields are optional for older captures.",
      "properties": {
        "commit": {"type": ["string", "null"]},
        "modified": {"type": ["boolean", "null"]},
        "modified_paths": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Sorted repository-relative changed/untracked paths, including both rename/copy paths. Ignored files are excluded; null means unknown."},
        "snapshot_at": {"type": "string", "format": "date-time", "description": "UTC start of the repository-state observation, not the capture timestamp."},
        "snapshot_scope": {"const": "process_first_use"}
      }
    },
    "frame": {
      "type": "object",
      "required": ["file", "width", "height", "resolution", "pixel_format", "captured_at", "exposure_lines", "gain", "byte_length", "sha256"],
      "properties": {
        "file": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.raw$"},
        "width": {"enum": [1280, 2592]},
        "height": {"enum": [960, 1944]},
        "resolution": {"enum": ["1280x960", "2592x1944"]},
        "pixel_format": {"const": "RAW8_RGGB"},
        "captured_at": {"type": "string", "format": "date-time", "description": "UTC host read completion; replay retains the original time."},
        "exposure_lines": {"type": "integer", "minimum": 1, "maximum": 3000, "description": "Sensor lines, not seconds."},
        "gain": {"type": "integer", "minimum": 1, "maximum": 70, "description": "Sensor register units, not e-/ADU or dB."},
        "byte_length": {"type": "integer", "enum": [1228800, 5038848]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_type": {"enum": ["camera", "replay"]},
        "white_balance_gains": {"$ref": "#/$defs/gains"},
        "annotation_file": {"type": "string"},
        "software": {"$ref": "#/$defs/software"},
        "provenance": {"type": "object", "description": "Replay dataset, original filename and checksum; previous provenance may be nested."}
      },
      "allOf": [
        {"if": {"properties": {"resolution": {"const": "1280x960"}}}, "then": {"properties": {"width": {"const": 1280}, "height": {"const": 960}, "byte_length": {"const": 1228800}}}},
        {"if": {"properties": {"resolution": {"const": "2592x1944"}}}, "then": {"properties": {"width": {"const": 2592}, "height": {"const": 1944}, "byte_length": {"const": 5038848}}}}
      ]
    }
  }
}
